{
  "_comment": "v5：SessionStart 注入路由锚点（5 类任务→skill + 开发阶段链）+ 注册表自动刷新；子智能体上下文注入一行协议锚点",
  "description": "MyWorkflow — v5 hook 路由入口 + 5 类任务 + 项目文档体系",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
