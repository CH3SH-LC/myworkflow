{
  "_comment": "v2 设计决策：SessionStart 注入完整工作流指令（LLM 语义路由），UserPromptSubmit 做轻量关键词硬路由作为程序化兜底。",
  "description": "MyWorkflow — v2 六组 skills / 五分类运行时路由。SessionStart 注入分类指令 + skill 清单；UserPromptSubmit 关键词匹配注入路由提醒",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\" --reset",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
