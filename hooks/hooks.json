{
  "_comment": "v2.0.0：SessionStart 注入阶段感知锚点（分类概念 + 阶段→skill 链）+ 注册表自动刷新；子智能体上下文注入一行协议锚点",
  "description": "MyWorkflow — 2.0 扁平化 + 阶段感知锚点 + 专项注册表",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
