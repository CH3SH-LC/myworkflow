{
  "_comment": "v3.1：SessionStart 注入分类概念锚点 + 注册表自动刷新；子智能体上下文注入一行协议锚点",
  "description": "MyWorkflow — v3.1 扁平化 + 分类概念锚点 + 专项注册表",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
