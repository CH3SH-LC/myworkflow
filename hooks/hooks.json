{
  "_comment": "v2.2.0（三级协作模型）：SessionStart 注入工作级别判定（L1/L2/L3）+ 任务分类 + 加载时机说明（禁止阶段拆分）+ 注册表自动刷新；子智能体上下文注入一行协作协议锚点（L2 子智能体 / L3 leaf 均适用）",
  "description": "MyWorkflow — 2.2.0 三级协作模型（L1 单智能体 / L2 子智能体 / L3 团队）+ 专项注册表",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
