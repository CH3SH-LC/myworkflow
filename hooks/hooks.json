{
  "_comment": "v3 扁平化：删除 UserPromptSubmit 硬路由与 PostToolUse 唠叨。仅保留 SessionStart 极简行为锚点（~70 字）。",
  "description": "MyWorkflow — v3 扁平化：技能直接按描述触发，无分类仪式、无路由 hop",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
